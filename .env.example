# ==============================================================================
# Nutri AI — Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - This file contains placeholder values for local development documentation only.
# - DO NOT place actual passwords, production secrets, or private API keys here.
# - Copy this file to .env for local configuration (which is git-ignored).
# ==============================================================================

# Server & Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL running via Docker Desktop)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nutriai
DATABASE_USERNAME=nutri_user
DATABASE_PASSWORD=change_this_in_local_env

# JWT Security (Minimum 256-bit cryptographically random secret string)
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string_for_local_dev
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origin (Vite frontend dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# External AI Provider (Phase 2 - Placeholder only)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_placeholder

